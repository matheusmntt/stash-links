# Cadastro de novas contas. A primeira conta sempre pode ser criada pela tela inicial;
# depois disso, só é possível criar contas com ALLOW_SIGNUP=true.
# ALLOW_SIGNUP=true

# Opcional: duração da sessão web em minutos (padrão: 10080 = 7 dias)
# AUTH_SESSION_MINUTES=10080

# Opcional: pasta onde fica o stash.db (padrão: ./data)
# STASH_DATA_DIR=./data
