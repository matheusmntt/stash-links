# --- Banco de dados (Turso) ------------------------------------------------
# Obrigatório em produção. Sem essas variáveis, em desenvolvimento, usa data/stash.db.
#   turso db create stash
#   turso db show stash --url        → TURSO_DATABASE_URL
#   turso db tokens create stash     → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://stash-seu-usuario.turso.io
TURSO_AUTH_TOKEN=

# --- Cadastro ----------------------------------------------------------------
# O cadastro é aberto por padrão. Use "false" para fechar a criação de novas contas
# (quem já tem conta continua entrando normalmente).
# ALLOW_SIGNUP=false

# --- Extensão do navegador ---------------------------------------------------
# Endereço público do Stash, gravado na extensão baixada em /extensao.
# Na Vercel, se vazio, usa o domínio de produção do projeto automaticamente.
# APP_URL=https://stash.seudominio.com

# --- Opcional ----------------------------------------------------------------
# Duração da sessão web em minutos (padrão: 10080 = 7 dias)
# AUTH_SESSION_MINUTES=10080
